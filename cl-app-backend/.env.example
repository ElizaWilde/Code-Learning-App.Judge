# Required. Supply these through a secret manager in production.
# CODEBOX_JWT_SECRET must contain at least 32 characters.
CODEBOX_JWT_SECRET=
# CODEBOX_ADMIN_PASSWORD must contain at least 12 characters.
CODEBOX_ADMIN_PASSWORD=

# Optional bootstrap identity and token lifetime.
CODEBOX_ADMIN_USERNAME=admin
CODEBOX_JWT_EXPIRES_IN_SECONDS=604800

# Request and judge limits (defaults shown).
CODEBOX_JSON_BODY_LIMIT_BYTES=65536
CODEBOX_JUDGE_MAX_SOURCE_BYTES=51200
CODEBOX_JUDGE_RATE_LIMIT_WINDOW_MS=60000
CODEBOX_JUDGE_RATE_LIMIT_MAX_REQUESTS=10
