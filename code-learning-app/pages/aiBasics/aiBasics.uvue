</template>

<script setup lang="uts">
	import { openStudyModule } from '../../utils/studyModule.uts'
	import { getCurrentLanguage } from '../../utils/i18n.uts'

	const ACTIVE_PROJECT_KEY = 'activeProjectId'
	const currentLanguage = ref(getCurrentLanguage() as string)
	const copyMap = {
		en: {
			eyebrow: 'AI Basic Knowledge',
			title: 'Build a clear foundation for modern AI tools',
			subtitle: 'This path gives you the concepts needed to understand LLM apps before using them in coding projects.',
			whatYouWillLearn: 'What you will learn',
			summary: 'Machine learning basics, tokens, prompts, embeddings, model limits, and responsible usage.',
			modules: 'Modules',
			module1Title: '1. AI and machine learning basics',
			module1Copy: 'Understand training, inference, data, and what models actually do.',
			module2Title: '2. How large language models work',
			module2Copy: 'Learn about tokens, context windows, completions, and reasoning limits.',
			module3Title: '3. Prompting and evaluation',
			module3Copy: 'Write clearer prompts and evaluate responses for quality and reliability.',
			module4Title: '4. Safety and practical workflows',
			module4Copy: 'Use AI responsibly for coding, writing, research, and everyday productivity.',
			projectCases: 'Project Cases',
			intermediate: 'Intermediate',
			advanced: 'Advanced',
			project1Copy: 'Use LLMs to review code for bugs, style issues, and performance improvements with prompt engineering.',
			project2Copy: 'Build a conversational assistant with context awareness, proper error handling, and response evaluation.',
			project3Copy: 'Create an app that generates essays, summaries, or code based on user prompts with quality checks.',
		},
		zh: {
			eyebrow: 'AI 基础知识',
			title: '为现代 AI 工具打下清晰基础',
			subtitle: '这条路径帮助你在编码项目中使用 LLM 应用之前先理解必要概念。',
			whatYouWillLearn: '你将学到',
			summary: '机器学习基础、Token、提示词、Embedding、模型限制以及负责任的使用方式。',
			modules: '模块',
			module1Title: '1. AI 与机器学习基础',
			module1Copy: '理解训练、推理、数据以及模型到底在做什么。',
			module2Title: '2. 大语言模型的工作原理',
			module2Copy: '了解 Token、上下文窗口、补全和推理限制。',
			module3Title: '3. 提示词与评估',
			module3Copy: '编写更清晰的提示词，并从质量与可靠性角度评估响应。',
			module4Title: '4. 安全与实用工作流',
			module4Copy: '在编码、写作、研究和日常效率场景中负责任地使用 AI。',
			projectCases: '项目案例',
			intermediate: '中级',
			advanced: '高级',
			project1Copy: '使用 LLM 和提示词工程来审查代码中的 bug、风格问题和性能改进点。',
			project2Copy: '构建一个具备上下文感知、良好错误处理和响应评估能力的对话助手。',
			project3Copy: '创建一个可根据用户提示生成文章、摘要或代码，并进行质量检查的应用。',
		},
	} as any

	const copy = computed(() => {
		return copyMap[currentLanguage.value] || copyMap.en
	})

	const openModule = (moduleId : string) => {
		openStudyModule(moduleId)
	}

	const openProject = (projectId: string) => {
		uni.setStorageSync(ACTIVE_PROJECT_KEY, projectId)
		uni.navigateTo({
			url: '/pages/projectShowcase/projectShowcase'
		})
	}

	onShow(() => {
		currentLanguage.value = getCurrentLanguage()
	})
</script>

