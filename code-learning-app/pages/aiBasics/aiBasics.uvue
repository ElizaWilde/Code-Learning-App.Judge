				<text class="project-tech">Prompting · API Integration · Evaluation</text>
			</view>
			<view class="project-card" @tap="openProject('ai-chatbot-builder')">
				<view class="project-header">
					<text class="project-title">Smart Chatbot Builder</text>
					<text class="project-badge">{{ copy.advanced }}</text>
				</view>
				<text class="project-copy">{{ copy.project2Copy }}</text>
				<text class="project-tech">LLM APIs · Context Management · UX</text>
