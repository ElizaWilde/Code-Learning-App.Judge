<!-- 功能：首页导航页，聚合学习模块、任务入口和主要功能跳转。 -->
<template>
	<view class="page">
			<view class="logo-frame">
				<image class="logo" src="/static/logo.png" mode="aspectFit"></image>
			</view>

			<view class="content">
				<text class="title">{{ copy.welcome }}</text>
				<text class="title">CodeBox</text>
				<text class="subtitle">{{ copy.subtitle }}</text>
			</view>

			<button class="cta" @tap="handleStart">{{ copy.cta }}</button>
	</view>
</template>

<script setup lang="uts">
	import { getCurrentLanguage } from '../../utils/i18n.uts'

	type LanguageCode = 'en' | 'zh'
	type IndexCopy = {
		welcome: string
		subtitle: string
		cta: string
	}

	const currentLanguage = ref(getCurrentLanguage() as LanguageCode)
	const copyMap = {
		en: {
			welcome: 'Welcome to',
			subtitle: 'The best AI coding learning app',
			cta: "Let's Go",
		},
		zh: {
			welcome: '欢迎来到',
			subtitle: '最好用的 AI 编程学习应用',
			cta: '开始使用',
		},
	} as Record<LanguageCode, IndexCopy>

	const copy = computed(() : IndexCopy => {
		return copyMap[currentLanguage.value]
	})

	const openStudyTab = () => {
		uni.switchTab({
			url: '/pages/study/study',
		})
	}

	const handleStart = () => {
		const savedUsername = uni.getStorageSync('loggedInUser') as string
		if (savedUsername.length > 0) {
			openStudyTab()
			return
		}

		uni.navigateTo({
			url: '/pages/login/login',
		})
	}

	onShow(() => {
		currentLanguage.value = getCurrentLanguage()
	})
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		padding: 140px 28px 34px;
		justify-content: space-between;
		align-items: center;
		background-color: #005174;
		background-image: linear-gradient(180deg, #00708f 0%, #4985a8 46%, #d67b65 74%, #c28a23 100%);
	}

	.logo-frame {
		display: flex;
		width: 126px;
		height: 126px;
		border-radius: 32px;
		background-color: #050505;
		justify-content: center;
		align-items: center;
		box-shadow: 0 20px 36px rgba(0, 0, 0, 0.18);
	}

	.logo {
		width: 74px;
		height: 74px;
	}

	.content {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.title {
		font-size: 32px;
		line-height: 38px;
		font-weight: 700;
		color: #ffffff;
		text-align: center;
		text-shadow: 0 3px 8px rgba(0, 0, 0, 0.18);
	}

	.subtitle {
		margin-top: 18px;
		font-size: 14px;
		color: rgba(255, 255, 255, 0.92);
		text-align: center;
	}

	.cta {
		width: 100%;
		height: 40px;
		border-radius: 12px;
		border-width: 0;
		background-color: rgba(97, 62, 38, 0.82);
		color: #ffffff;
		font-size: 16px;
		font-weight: 600;
	}
</style>
