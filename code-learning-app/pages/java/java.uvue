<!-- 功能：Java 学习页，展示 Java 知识模块、课程内容和练习入口。 -->
<template>
	<scroll-view class="page" scroll-y="true">
		<view class="hero">
			<text class="eyebrow">Java</text>
			<text class="title">{{ copy.title }}</text>
			<text class="subtitle">{{ copy.subtitle }}</text>
		</view>

		<view class="summary-card">
			<text class="summary-title">{{ copy.whatYouWillLearn }}</text>
			<text class="summary-copy">{{ copy.summary }}</text>
		</view>

		<view class="section">
			<text class="section-title">{{ copy.modules }}</text>
			<view class="lesson-card" @tap="openModule('java-syntax')">
				<text class="lesson-title">{{ copy.module1Title }}</text>
				<text class="lesson-copy">{{ copy.module1Copy }}</text>
			</view>
			<view class="lesson-card" @tap="openModule('java-oop')">
				<text class="lesson-title">{{ copy.module2Title }}</text>
				<text class="lesson-copy">{{ copy.module2Copy }}</text>
			</view>
			<view class="lesson-card" @tap="openModule('java-collections')">
				<text class="lesson-title">{{ copy.module3Title }}</text>
				<text class="lesson-copy">{{ copy.module3Copy }}</text>
			</view>
			<view class="lesson-card" @tap="openModule('java-backend')">
				<text class="lesson-title">{{ copy.module4Title }}</text>
				<text class="lesson-copy">{{ copy.module4Copy }}</text>
			</view>
		</view>

		<view class="section">
			<text class="section-title">{{ copy.projectCases }}</text>
			<view class="project-card" @tap="openProject('java-student-mgmt')">
				<view class="project-header">
					<text class="project-title">Student Management System</text>
					<text class="project-badge">{{ copy.intermediate }}</text>
				</view>
				<text class="project-copy">{{ copy.project1Copy }}</text>
				<text class="project-tech">Classes · Collections · OOP</text>
			</view>
			<view class="project-card" @tap="openProject('java-banking-app')">
				<view class="project-header">
					<text class="project-title">Banking System</text>
					<text class="project-badge">{{ copy.advanced }}</text>
				</view>
				<text class="project-copy">{{ copy.project2Copy }}</text>
				<text class="project-tech">Inheritance · Exceptions · Design Patterns</text>
			</view>
			<view class="project-card" @tap="openProject('java-library-api')">
				<view class="project-header">
					<text class="project-title">Library Management API</text>
					<text class="project-badge">{{ copy.advanced }}</text>
				</view>
				<text class="project-copy">{{ copy.project3Copy }}</text>
				<text class="project-tech">REST · JSON · Backend Structure</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { openStudyModule } from '../../utils/studyModule.uts'
	import { getCurrentLanguage } from '../../utils/i18n.uts'

	const ACTIVE_PROJECT_KEY = 'activeProjectId'
	const currentLanguage = ref(getCurrentLanguage() as string)
	const copyMap = {
		en: {
			title: 'Learn backend-friendly programming structure',
			subtitle: 'This path focuses on clean syntax, object-oriented thinking, and common server-side patterns.',
			whatYouWillLearn: 'What you will learn',
			summary: 'Classes, methods, collections, exceptions, interfaces, and core problem solving with Java.',
			modules: 'Modules',
			module1Title: '1. Java syntax fundamentals',
			module1Copy: 'Get comfortable with types, methods, conditionals, and loops.',
			module2Title: '2. Object-oriented programming',
			module2Copy: 'Understand classes, constructors, encapsulation, inheritance, and interfaces.',
			module3Title: '3. Collections and exceptions',
			module3Copy: 'Use lists, maps, sets, and handle runtime errors predictably.',
			module4Title: '4. Java for backend apps',
			module4Copy: 'Connect Java fundamentals to APIs, services, and layered design.',
			projectCases: 'Project Cases',
			intermediate: 'Intermediate',
			advanced: 'Advanced',
			project1Copy: 'Design classes for students and courses, manage collections, and implement CRUD operations.',
			project2Copy: 'Build accounts, transactions, and exception handling with proper encapsulation and layered architecture.',
			project3Copy: 'Create a REST API backend with book inventory, borrowing logic, and request/response handling.',
		},
		zh: {
			title: '学习适合后端的程序结构',
			subtitle: '这条路径聚焦清晰语法、面向对象思维和常见服务端模式。',
			whatYouWillLearn: '你将学到',
			summary: '类、方法、集合、异常、接口，以及 Java 核心问题解决能力。',
			modules: '模块',
			module1Title: '1. Java 语法基础',
			module1Copy: '熟悉类型、方法、条件判断和循环。',
			module2Title: '2. 面向对象编程',
			module2Copy: '理解类、构造器、封装、继承和接口。',
			module3Title: '3. 集合与异常',
			module3Copy: '使用列表、映射、集合，并稳定处理运行时错误。',
			module4Title: '4. Java 后端应用',
			module4Copy: '把 Java 基础连接到 API、服务和分层设计。',
			projectCases: '项目案例',
			intermediate: '中级',
			advanced: '高级',
			project1Copy: '为学生和课程设计类，管理集合，并实现 CRUD 操作。',
			project2Copy: '构建账户、交易和异常处理，并保持良好封装与分层架构。',
			project3Copy: '创建一个带有图书库存、借阅逻辑和请求响应处理的 REST API 后端。',
		},
	} as any

	const copy = computed(() => {
		return copyMap[currentLanguage.value] || copyMap.en
	})

	const openModule = (moduleId : string) => {
		openStudyModule(moduleId)
	}

	const openProject = (projectId: string) => {
		uni.setStorageSync(ACTIVE_PROJECT_KEY, projectId)
		uni.navigateTo({
			url: '/pages/projectShowcase/projectShowcase'
		})
	}

	onShow(() => {
		currentLanguage.value = getCurrentLanguage()
	})
</script>

