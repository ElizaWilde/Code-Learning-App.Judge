<!-- 功能：学习提醒设置页，管理每日练习提醒时间、开关和重复规则 -->
<template>
	<scroll-view class="page" scroll-y="true">
		<view class="hero">
			<text class="eyebrow">{{ copy.eyebrow }}</text>
			<text class="title">{{ copy.title }}</text>
			<text class="subtitle">{{ copy.subtitle }}</text>
		</view>

		<view class="settings-card">
			<view class="setting-item">
				<view class="setting-header">
					<text class="setting-label">{{ copy.reminderTime }}</text>
					<text class="setting-value">{{ reminderTime }}</text>
				</view>
				<text class="setting-description">{{ copy.reminderTimeDescription }}</text>
				<button class="setting-btn" @tap="pickTime">{{ copy.changeTime }}</button>
			</view>

			<view class="divider"></view>

			<view class="setting-item">
				<view class="setting-header">
					<text class="setting-label">{{ copy.enableReminders }}</text>
					<switch :checked="remindersEnabled" @change="toggleReminders($event.detail.value)" />
				</view>
				<text class="setting-description">{{ copy.enableRemindersDescription }}</text>
			</view>

			<view class="divider"></view>

			<view class="setting-item">
				<text class="setting-label">{{ copy.testReminder }}</text>
				<text class="setting-description">{{ copy.testReminderDescription }}</text>
				<button class="test-btn" @tap="testReminder">{{ copy.testNow }}</button>
			</view>
		</view>

		<view class="info-card">
			<text class="info-title">{{ copy.howItWorks }}</text>
			<text class="info-text">{{ copy.infoOne }}</text>
			<text class="info-text">{{ copy.infoTwo }}</text>
			<text class="info-text">{{ copy.infoThree }}</text>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getCurrentLanguage } from '../../utils/i18n.uts'

	const REMINDER_TIME_KEY = 'reminderTime'
	const REMINDERS_ENABLED_KEY = 'remindersEnabled'
	const SCHEDULED_REMINDERS_KEY = 'scheduledReminders'

	// 提醒设置状态保存在本地，个人中心只提供入口
	const reminderTime = ref('09:00')
	const remindersEnabled = ref(false)
	// 不同运行环境对系统通知支持不同，用这两个状态决定是否降级到弹窗
	const notificationSupported = ref(false)
	const notificationPermission = ref('default')
	const currentLanguage = ref(getCurrentLanguage() as string)

	const copyMap = {
		en: {
			eyebrow: 'Reminder Settings',
			title: 'Daily Practice Reminder',
			subtitle: 'Configure your daily coding practice reminders to stay consistent.',
			reminderTime: 'Reminder Time',
			reminderTimeDescription: 'Choose when you want to receive daily reminders.',
			changeTime: 'Change Time',
			enableReminders: 'Enable Reminders',
			enableRemindersDescription: 'Turn daily reminders on or off.',
			testReminder: 'Test Reminder',
			testReminderDescription: 'See how your reminder will appear.',
			testNow: 'Test Now',
			howItWorks: 'How it works',
			infoOne: '• You will receive a daily reminder at your chosen time',
			infoTwo: '• Tap "Practice Now" to go directly to coding tasks',
			infoThree: '• Tap "Later" to dismiss and be reminded tomorrow',
			notificationTitle: 'Daily Practice Reminder',
			notificationBody: 'Time for your daily coding practice. Open the app to continue.',
			remindersDisabled: 'Reminders disabled',
			reminderScheduled: 'Daily reminder scheduled',
			reminderTimeSetPrefix: 'Reminder time set to ',
			modalTitle: 'Daily Coding Practice',
			later: 'Later',
			practiceNow: 'Practice Now',
			remindersAreDisabled: 'Reminders are disabled',
		},
		zh: {
			eyebrow: '提醒设置',
			title: '每日练习提醒',
			subtitle: '设置你的每日编程练习提醒，保持学习节奏。',
			reminderTime: '提醒时间',
			reminderTimeDescription: '选择你希望接收每日提醒的时间。',
			changeTime: '修改时间',
			enableReminders: '开启提醒',
			enableRemindersDescription: '打开或关闭每日提醒。',
			testReminder: '测试提醒',
			testReminderDescription: '预览提醒显示效果。',
			testNow: '立即测试',
			howItWorks: '使用说明',
			infoOne: '• 你会在设定时间收到每日提醒',
			infoTwo: '• 点击“立即练习”可直接进入刷题页',
			infoThree: '• 点击“稍后”会关闭本次提醒，明天再提醒',
			notificationTitle: '每日练习提醒',
			notificationBody: '该进行今天的编程练习了，打开应用继续学习。',
			remindersDisabled: '提醒已关闭',
			reminderScheduled: '已设置每日提醒',
			reminderTimeSetPrefix: '提醒时间已设置为 ',
			modalTitle: '每日编程练习',
			later: '稍后',
			practiceNow: '立即练习',
			remindersAreDisabled: '提醒当前已关闭',
		},
	}

	const copy = computed(() => {
		return copyMap[currentLanguage.value] || copyMap.en
	})

	// 当前页面内存里的定时器 id，切换时间或关闭提醒时需要清理
	let reminderTimeoutId: number | null = null
	// Web 端通过 service worker 展示更接近系统通知的提醒
	let swRegistration: ServiceWorkerRegistration | null = null

	// App 运行时优先使用 plus.push；H5 环境使用 Notification / Service Worker
	const isPlusRuntime = () => typeof plus !== 'undefined' && plus != null
	const isWebNotificationAvailable = () => typeof window !== 'undefined' && typeof Notification !== 'undefined'
	const isServiceWorkerAvailable = () => typeof navigator !== 'undefined' && 'serviceWorker' in navigator

	const loadReminderSettings = () => {
		// 从本地存储恢复上次选择的提醒时间和开关状态
		const savedTime = uni.getStorageSync(REMINDER_TIME_KEY) as string
		if (savedTime) {
			reminderTime.value = savedTime
		}

		const savedEnabled = uni.getStorageSync(REMINDERS_ENABLED_KEY) as string
		if (savedEnabled) {
			remindersEnabled.value = savedEnabled === 'true'
		}
	}

	const saveReminderSettings = () => {
		// 每次修改时间或开关后立即持久化，返回页面时可恢复
		uni.setStorageSync(REMINDER_TIME_KEY, reminderTime.value)
		uni.setStorageSync(REMINDERS_ENABLED_KEY, remindersEnabled.value.toString())
	}

	const saveScheduledReminder = (nextReminder: number | null) => {
		if (nextReminder === null) {
			// 关闭提醒时清空下一次触发时间
			uni.setStorageSync(SCHEDULED_REMINDERS_KEY, '')
			return
		}

		// 保存下一次提醒时间戳，页面重新打开时可判断是否错过提醒
		uni.setStorageSync(SCHEDULED_REMINDERS_KEY, JSON.stringify({
			time: reminderTime.value,
			enabled: remindersEnabled.value,
			nextReminder
		}))
	}

	const getNotificationTitle = () => copy.value.notificationTitle
	const getNotificationBody = () => copy.value.notificationBody

	const createOsNotification = async (title: string, body: string) => {
		if (isPlusRuntime() && plus.push && plus.push.createMessage) {
			try {
				// App 环境优先创建原生推送消息
				plus.push.createMessage(title, body, {
					title,
					content: body,
					cover: false
				})
				return
			} catch (error) {
				console.warn('plus.push.createMessage failed', error)
			}
		}

		if (swRegistration && swRegistration.showNotification) {
			try {
				// H5 已注册 service worker 时用 showNotification
				await swRegistration.showNotification(title, {
					body,
					tag: 'daily-practice-reminder',
					renotify: true,
					data: { url: '/pages/task/task' }
				})
				return
			} catch (error) {
				console.warn('Service worker notification failed', error)
			}
		}

		if (isWebNotificationAvailable() && Notification.permission === 'granted') {
			// 最后退回浏览器 Notification API
			new Notification(title, {
				body,
				tag: 'daily-practice-reminder'
			})
		}
	}

	const requestNotificationPermission = async () => {
		if (isPlusRuntime()) {
			// App 端由系统/运行时处理权限，这里直接视为支持
			notificationSupported.value = true
			return
		}

		if (!isWebNotificationAvailable()) {
			// 不支持 Notification 时后续会用 uni.showModal 兜底
			notificationSupported.value = false
			return
		}

		notificationSupported.value = true
		notificationPermission.value = Notification.permission
		if (Notification.permission === 'default') {
			try {
				// 浏览器首次使用通知前需要请求权限
				const result = await Notification.requestPermission()
				notificationPermission.value = result
			} catch (error) {
				console.warn('Notification permission request failed', error)
			}
		}
	}

	const registerServiceWorker = async () => {
		if (!isServiceWorkerAvailable() || !isWebNotificationAvailable()) {
			return
		}

		try {
			// sw.js 负责承载 Web 通知能力
			swRegistration = await navigator.serviceWorker.register('/sw.js')
		} catch (error) {
			console.warn('Service worker registration failed', error)
		}
	}

	const clearReminderTimeout = () => {
		if (reminderTimeoutId !== null) {
			// 重新调度前清理旧定时器，避免同一时间弹出多次提醒
			clearTimeout(reminderTimeoutId)
			reminderTimeoutId = null
		}
	}

	const getNextReminderTimestamp = (): number => {
		const [hours, minutes] = reminderTime.value.split(':').map(Number)
		const now = new Date()
		const reminderDate = new Date(now.getFullYear(), now.getMonth(), now.getDate(), hours, minutes)
		if (reminderDate.getTime() <= now.getTime()) {
			// 今天的提醒时间已过，则安排到明天同一时间
			reminderDate.setDate(reminderDate.getDate() + 1)
		}
		return reminderDate.getTime()
	}

	const scheduleReminders = async () => {
		saveReminderSettings()
		clearReminderTimeout()

		if (!remindersEnabled.value) {
			// 关闭提醒时只保存设置并清空调度记录
			saveScheduledReminder(null)
			uni.showToast({
				title: copy.value.remindersDisabled,
				icon: 'success',
				duration: 2000
			})
			return
		}

		await requestNotificationPermission()
		await registerServiceWorker()

		const now = Date.now()
		const nextReminder = getNextReminderTimestamp()
		saveScheduledReminder(nextReminder)

		const delay = Math.max(0, nextReminder - now)
		reminderTimeoutId = setTimeout(async () => {
			// 到点后发送通知，并立即安排下一次提醒
			await createOsNotification(getNotificationTitle(), getNotificationBody())
			saveScheduledReminder(getNextReminderTimestamp())
			scheduleReminders()
		}, delay) as unknown as number

		uni.showToast({
			title: copy.value.reminderScheduled,
			icon: 'success',
			duration: 2000
		})
	}

	const syncReminderStatus = () => {
		const reminderDataStr = uni.getStorageSync(SCHEDULED_REMINDERS_KEY) as string
		if (!reminderDataStr) {
			return
		}

		try {
			const reminderData = JSON.parse(reminderDataStr)
			// 用已调度数据恢复页面状态，避免本地 key 不一致
			if (typeof reminderData.time === 'string') {
				reminderTime.value = reminderData.time
			}
			if (typeof reminderData.enabled === 'boolean') {
				remindersEnabled.value = reminderData.enabled
			}
		} catch (error) {
			// ignored
		}
	}

	const tryTriggerPastReminder = async () => {
		const reminderDataStr = uni.getStorageSync(SCHEDULED_REMINDERS_KEY) as string
		if (!reminderDataStr) {
			return
		}

		try {
			const reminderData = JSON.parse(reminderDataStr)
			const nextReminder = Number(reminderData.nextReminder || 0)
			const now = Date.now()
			if (reminderData.enabled && now >= nextReminder && now <= nextReminder + 5 * 60 * 1000) {
				// 页面刚打开时，如果错过的提醒仍在 5 分钟窗口内，则补发一次
				await createOsNotification(getNotificationTitle(), getNotificationBody())
				saveScheduledReminder(getNextReminderTimestamp())
				scheduleReminders()
			}
		} catch (error) {
			// ignored
		}
	}

	const pickTime = () => {
		const timeOptions = []
		for (let hour = 0; hour < 24; hour++) {
			for (let minute = 0; minute < 60; minute += 30) {
				// 提醒时间以 30 分钟为粒度
				const timeString = `${hour.toString().padStart(2, '0')}:${minute.toString().padStart(2, '0')}`
				timeOptions.push(timeString)
			}
		}

		let currentIndex = 0
		const currentTime = reminderTime.value
		for (let i = 0; i < timeOptions.length; i++) {
			if (timeOptions[i] >= currentTime) {
				currentIndex = i
				break
			}
		}

		uni.showActionSheet({
			itemList: timeOptions,
			itemColor: '#6b4cd3',
			success: (res) => {
				reminderTime.value = timeOptions[res.tapIndex]
				// 修改时间后立即重新调度
				scheduleReminders()
				uni.showToast({
					title: copy.value.reminderTimeSetPrefix + reminderTime.value,
					icon: 'success',
					duration: 1500
				})
			},
			fail: () => {
				// User cancelled time selection
			}
		})
	}

	const toggleReminders = (enabled: boolean) => {
		remindersEnabled.value = enabled
		saveReminderSettings()
		// 开关变化后立即更新定时器和持久化调度
		scheduleReminders()
	}

	const showReminderNotification = async () => {
		if (!notificationSupported.value) {
			// 通知能力不可用时，用应用内弹窗模拟提醒，并允许直接跳到练习页
			uni.showModal({
				title: copy.value.modalTitle,
				content: getNotificationBody(),
				showCancel: true,
				cancelText: copy.value.later,
				confirmText: copy.value.practiceNow,
				success: (res) => {
					if (res.confirm) {
						uni.switchTab({ url: '/pages/task/task' })
					}
				}
			})
			return
		}

		await createOsNotification(getNotificationTitle(), getNotificationBody())
	}

	const testReminder = async () => {
		if (remindersEnabled.value) {
			// 测试提醒不会改变下一次真实提醒时间
			await showReminderNotification()
		} else {
			uni.showToast({
				title: copy.value.remindersAreDisabled,
				icon: 'none'
			})
		}
	}

	onLoad(async () => {
		currentLanguage.value = getCurrentLanguage()
		loadReminderSettings()
		syncReminderStatus()
		await requestNotificationPermission()
		await registerServiceWorker()
		await tryTriggerPastReminder()
		scheduleReminders()
	})

	onShow(async () => {
		currentLanguage.value = getCurrentLanguage()
		loadReminderSettings()
		syncReminderStatus()
		await tryTriggerPastReminder()
		scheduleReminders()
	})
</script>

<style>
	.page {
		min-height: 100vh;
		padding: 20px 18px 28px;
		background-color: #f8f6ff;
	}

	.hero {
		padding: 12px 2px 18px;
	}

	.eyebrow {
		font-size: 13px;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: #6b4cd3;
	}

	.title {
		margin-top: 10px;
		font-size: 30px;
		line-height: 36px;
		font-weight: 700;
		color: #1b1d31;
	}

	.subtitle {
		margin-top: 10px;
		font-size: 14px;
		line-height: 21px;
		color: #666b86;
	}

	.settings-card {
		padding: 20px 16px;
		border-radius: 18px;
		background-color: #ffffff;
		box-shadow: 0 12px 26px rgba(65, 53, 130, 0.08);
	}

	.setting-item {
		margin-bottom: 8px;
	}

	.setting-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 6px;
	}

	.setting-label {
		font-size: 16px;
		font-weight: 600;
		color: #171925;
	}

	.setting-value {
		font-size: 16px;
		font-weight: 700;
		color: #6b4cd3;
	}

	.setting-description {
		font-size: 13px;
		line-height: 18px;
		color: #666b86;
		margin-bottom: 12px;
	}

	.setting-btn {
		width: 100%;
		height: 40px;
		border-radius: 10px;
		border-width: 1px;
		border-color: #6b4cd3;
		background-color: transparent;
		color: #6b4cd3;
		font-size: 14px;
		font-weight: 600;
	}

	.test-btn {
		width: 100%;
		height: 36px;
		border-radius: 8px;
		border-width: 1px;
		border-color: #6b4cd3;
		background-color: transparent;
		color: #6b4cd3;
		font-size: 14px;
		font-weight: 500;
	}

	.divider {
		height: 1px;
		background-color: #f0f0f0;
		margin: 16px 0;
	}

	.info-card {
		padding: 18px 16px;
		margin-top: 16px;
		border-radius: 18px;
		background-color: #ffffff;
		box-shadow: 0 12px 26px rgba(65, 53, 130, 0.08);
	}

	.info-title {
		font-size: 16px;
		font-weight: 600;
		color: #171925;
		margin-bottom: 12px;
	}

	.info-text {
		font-size: 13px;
		line-height: 20px;
		color: #666b86;
		margin-bottom: 6px;
	}
</style>
