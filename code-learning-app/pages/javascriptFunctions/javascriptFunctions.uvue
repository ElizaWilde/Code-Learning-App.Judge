<!-- 功能：JavaScript 函数学习页，讲解函数声明、参数、作用域和闭包基础。 -->
<template>
	<scroll-view class="page" scroll-y="true">
		<view class="hero">
			<text class="eyebrow">{{ copy.eyebrow }}</text>
			<text class="title">{{ copy.title }}</text>
			<text class="subtitle">{{ copy.subtitle }}</text>
		</view>

		<view class="section-card knowledge">
			<text class="section-tag">{{ copy.sectionTag }}</text>
			<text class="section-title">{{ copy.sectionTitle }}</text>
			<text class="section-copy">{{ copy.copyOne }}</text>
			<text class="section-copy">{{ copy.copyTwo }}</text>
			<text class="section-copy">{{ copy.copyThree }}</text>
		</view>

		<button class="practice-button" @tap="openPractice">{{ copy.practiceButton }}</button>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getCurrentLanguage } from '../../utils/i18n.uts'

	const currentLanguage = ref(getCurrentLanguage() as string)
	const copyMap = {
		en: {
			eyebrow: 'JavaScript Module 2',
			title: 'Functions and Control Flow',
			subtitle: 'Learn how to make decisions, repeat actions, and package logic into reusable units.',
			sectionTag: 'Knowledge Guide',
			sectionTitle: 'Core ideas',
			copyOne: 'Functions let you reuse logic instead of rewriting the same steps. Parameters pass input into a function and `return` sends a result back.',
			copyTwo: 'Control flow decides what code runs using `if`, `else`, `switch`, `for`, and `while`. These tools make programs react to user input and data conditions.',
			copyThree: 'When functions stay small and focused, code becomes easier to test and debug.',
			practiceButton: 'Go To Practice',
		},
		zh: {
			eyebrow: 'JavaScript 模块 2',
			title: '函数与流程控制',
			subtitle: '学习如何做判断、重复执行操作，并把逻辑封装成可复用单元。',
			sectionTag: '知识讲解',
			sectionTitle: '核心概念',
			copyOne: '函数让你复用逻辑，而不是反复重写相同步骤。参数把输入传入函数，`return` 把结果返回出来。',
			copyTwo: '流程控制通过 `if`、`else`、`switch`、`for` 和 `while` 决定执行哪些代码。这些工具让程序能够根据用户输入和数据条件做出反应。',
			copyThree: '当函数保持小而专注时，代码会更容易测试和调试。',
			practiceButton: '前往练习',
		},
	}

	const copy = computed(() => copyMap[currentLanguage.value] || copyMap.en)
	const openPractice = () => {
		uni.navigateTo({
			url: '/pages/javascriptFunctionsPractice/javascriptFunctionsPractice',
		})
	}
	onShow(() => {
		currentLanguage.value = getCurrentLanguage()
	})
</script>

