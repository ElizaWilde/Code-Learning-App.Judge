		font-weight: 700;
		color: #ffffff;
	}

	.summary-copy {
		margin-top: 10px;
		font-size: 14px;
		line-height: 21px;
		color: rgba(255, 255, 255, 0.92);
	}

	.section-title {
		margin-bottom: 12px;
		font-size: 18px;
		font-weight: 700;
		color: #1f2937;
	}

	.lesson-card {
		margin-bottom: 12px;
	}

	.lesson-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.lesson-title {
		font-size: 16px;
		font-weight: 700;
		color: #111827;
	}

	.lesson-copy {
		margin-top: 8px;
		font-size: 13px;
		line-height: 20px;
		color: #6b7280;
	}

	.status-done {
		padding: 5px 10px;
		border-radius: 999px;
		background-color: #dff7ea;
		font-size: 12px;
		font-weight: 700;
		color: #0c7a43;
	}

