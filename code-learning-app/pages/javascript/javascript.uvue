		border-radius: 18px;
		background-color: #ffffff;
		box-shadow: 0 12px 30px rgba(46, 61, 87, 0.08);
	}

	.project-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.project-title {
		font-size: 16px;
		font-weight: 700;
		color: #111827;
		flex: 1;
	}

	.project-badge {
		padding: 5px 10px;
		border-radius: 6px;
		background-color: #fef3c7;
		font-size: 12px;
		font-weight: 700;
		color: #b45309;
	}

	.project-copy {
		margin-top: 8px;
		font-size: 13px;
		line-height: 20px;
		color: #6b7280;
	}

	.project-tech {
