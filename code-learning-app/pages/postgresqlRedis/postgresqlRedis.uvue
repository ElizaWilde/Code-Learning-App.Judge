	const ACTIVE_PROJECT_KEY = 'activeProjectId'
	const currentLanguage = ref(getCurrentLanguage() as string)
	const copyMap = {
		en: {
			eyebrow: 'PostgreSQL and Redis',
			title: 'Understand storage, caching, and fast data access',
			subtitle: 'This path introduces relational queries, indexes, caching strategies, and common backend data flows.',
			whatYouWillLearn: 'What you will learn',
			summary: 'Tables, joins, indexing, Redis keys, cache patterns, and when to use each tool.',
			modules: 'Modules',
			module1Title: '1. PostgreSQL fundamentals',
			module1Copy: 'Create tables, insert data, and query structured information with SQL.',
			module2Title: '2. Relations and indexes',
			module2Copy: 'Use joins and indexes to keep queries correct and fast.',
			module3Title: '3. Redis basics',
			module3Copy: 'Work with strings, hashes, expiration, and common cache data shapes.',
			module4Title: '4. PostgreSQL plus Redis together',
			module4Copy: 'Combine persistent storage with caching to improve response time.',
			projectCases: 'Project Cases',
			intermediate: 'Intermediate',
			advanced: 'Advanced',
			project1Copy: 'Design normalized tables for products, orders, and users with proper foreign keys and indexes.',
			project2Copy: 'Implement session storage, leaderboards, and real-time counters using Redis data structures.',
			project3Copy: 'Build a system that reads from PostgreSQL, caches hot data in Redis, and handles cache invalidation.',
		},
		zh: {
			eyebrow: 'PostgreSQL 与 Redis',
			title: '理解存储、缓存与快速数据访问',
			subtitle: '这条路径会介绍关系查询、索引、缓存策略和常见后端数据流。',
			whatYouWillLearn: '你将学到',
			summary: '表、连接、索引、Redis Key、缓存模式以及各工具的使用场景。',
			modules: '模块',
			module1Title: '1. PostgreSQL 基础',
			module1Copy: '创建表、插入数据，并使用 SQL 查询结构化信息。',
			module2Title: '2. 关系与索引',
			module2Copy: '使用连接和索引保持查询正确且高效。',
			module3Title: '3. Redis 基础',
			module3Copy: '学习字符串、哈希、过期机制和常见缓存数据结构。',
			module4Title: '4. PostgreSQL 与 Redis 协同',
			module4Copy: '结合持久化存储与缓存来提升响应速度。',
			projectCases: '项目案例',
			intermediate: '中级',
			advanced: '高级',
			project1Copy: '为商品、订单和用户设计规范化数据表，并设置正确的外键和索引。',
			project2Copy: '使用 Redis 数据结构实现会话存储、排行榜和实时计数器。',
			project3Copy: '构建一个从 PostgreSQL 读取、在 Redis 缓存热点数据并处理缓存失效的系统。',
		},
	} as any

	const copy = computed(() => {
		return copyMap[currentLanguage.value] || copyMap.en
	})

	// 打开学习模块详情页前，先把模块 ID 写入本地存储
	const openModule = (moduleId : string) => {
		openStudyModule(moduleId)
	}

	// 项目案例通过 projectId 进入统一的项目展示页
	const openProject = (projectId: string) => {
		uni.setStorageSync(ACTIVE_PROJECT_KEY, projectId)
		uni.navigateTo({
			url: '/pages/projectShowcase/projectShowcase'
		})
	}

	// 页面重新显示时刷新语言文案
	onShow(() => {
		currentLanguage.value = getCurrentLanguage()
	})
</script>

