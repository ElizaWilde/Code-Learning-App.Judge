// 功能：管理社区帖子和评论的本地数据，提供发帖、详情、评论和用户身份标识能力
const COMMUNITY_COMMENTS_KEY_PREFIX = 'communityComments::'
const ACTIVE_COMMUNITY_POST_KEY = 'activeCommunityPostId'
const LOGIN_USER_KEY = 'loggedInUser'
const LOGIN_USER_TYPE_KEY = 'loggedInUserType'

// 用户类型会影响社区和个人中心是否展示专家标识
export type UserType = 'normal' | 'expert'

// 用户端公开帖子结构，后端审核通过后返回这些字段
export type CommunityPost = {
	id : string
	title : string
	summary : string
	content : string
	meta : string
	badge : string
	tags : string[]
	author : string
	authorType : UserType
}

// 评论目前保存在本地，以 postId 隔离不同帖子的评论列表
export type CommunityComment = {
	id : string
	postId : string
	author : string
	authorType : UserType
	content : string
	meta : string
}

// 从本地登录信息读取当前用户类型
export function getCurrentUserType() : UserType {
	const storedType = uni.getStorageSync(LOGIN_USER_TYPE_KEY) as string
	if (storedType == 'expert') {
		return 'expert'
	}

	return 'normal'
}

export function getUserBadgeLabel(userType : UserType) : string {
	if (userType == 'expert') {
		// 专家用户在社区评论和帖子作者旁展示身份标识
		return '大神'
	}

	return ''
}

// 社区发帖和评论默认使用当前登录用户名
export function getCurrentUsername() : string {
	const username = uni.getStorageSync(LOGIN_USER_KEY) as string
	if (username.length > 0) {
		return username
	}

	return 'Guest'
}

function getCommentsStorageKey(postId : string) : string {
	// 每个帖子的评论使用独立 key，避免不同帖子评论串在一起
	return COMMUNITY_COMMENTS_KEY_PREFIX + postId
}

function readComments(postId : string) : CommunityComment[] {
	const storedValue = uni.getStorageSync(getCommentsStorageKey(postId))
	if (storedValue == null || storedValue == '') {
		return []
	}

	return storedValue as CommunityComment[]
}


// 打开帖子详情前保存当前帖子 ID
export function setActiveCommunityPostId(postId : string) {
	// 详情页通过这个 key 读取当前要展示的帖子
	uni.setStorageSync(ACTIVE_COMMUNITY_POST_KEY, postId)
}

export function getActiveCommunityPostId() : string {
	return uni.getStorageSync(ACTIVE_COMMUNITY_POST_KEY) as string
}

export function getCommentsForPost(postId : string) : CommunityComment[] {
	return readComments(postId)
}

// 把评论保存到当前帖子对应的本地评论列表
export function addCommentToPost(postId : string, content : string) {
	const trimmedContent = content.trim()
	if (trimmedContent.length == 0) {
		// 空评论不写入本地存储
		return
	}

	const comments = readComments(postId)
	const author = getCurrentUsername()
	const authorType = getCurrentUserType()
	const nextComment = {
		// 本地评论用时间戳生成临时 id，足够区分当前设备上的评论
		id: 'comment-' + String(Date.now()),
		postId,
		author,
		authorType,
		content: trimmedContent,
		meta: 'Comment by ' + author,
	} as CommunityComment

	// 追加评论后整体写回本地存储
	uni.setStorageSync(getCommentsStorageKey(postId), [...comments, nextComment])
}
