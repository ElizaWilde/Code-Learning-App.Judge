			}
	}
}

export function isWebVideoUrl(url : string) : boolean {
	return url.indexOf('bilibili.com') >= 0 || url.indexOf('player.bilibili.com') >= 0
}

function extractBilibiliBvid(url : string) : string {
	const markerIndex = url.indexOf('BV')
	if (markerIndex < 0) {
		return ''
	}

	const allowedChars = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
	let bvid = 'BV'
	let index = markerIndex + 2
	while (index < url.length) {
		const char = url.charAt(index)
		if (allowedChars.indexOf(char) < 0) {
			break
		}
		bvid += char
		index += 1
	}

	return bvid.length > 2 ? bvid : ''
}

export function toWebVideoPlayerUrl(url : string) : string {
	if (url.indexOf('player.bilibili.com') >= 0) {
		return url
	}

	const bvid = extractBilibiliBvid(url)
	if (bvid.length > 0) {
		return 'https://player.bilibili.com/player.html?bvid=' + bvid + '&page=1&autoplay=0&danmaku=0'
	}

	return url
}
