// 功能：提供语言读取和保存方法，支持页面根据当前语言切换文案
const APP_LANGUAGE_KEY = 'appLanguage'

export type LanguageCode = 'en' | 'zh'

// 读取当前语言，默认英文
export function getCurrentLanguage() : LanguageCode {
	const storedLanguage = (uni.getStorageSync(APP_LANGUAGE_KEY) as string).trim()
	if (storedLanguage == 'zh') {
		return 'zh'
	}

	return 'en'
}

// 保存当前语言，页面 onShow 时会重新读取
export function setCurrentLanguage(language : LanguageCode) {
	uni.setStorageSync(APP_LANGUAGE_KEY, language)
}
