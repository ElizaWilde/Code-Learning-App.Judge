// 功能：管理学习打卡数据，提供今日打卡、连续天数和热力图统计
const CHECK_IN_KEY_PREFIX = 'practiceCheckIn::'
const LOGIN_USER_KEY = 'loggedInUser'

// 每天一条打卡记录，count 当前只表示当天是否完成过练习
export type CheckInRecord = {
	date : string
	count : number
}

// 热力图单元格：level 负责映射不同颜色深浅
export type HeatmapCell = {
	key : string
	date : string
	count : number
	level : number
}

// 个人中心展示的打卡摘要
export type CheckInSummary = {
	streak : number
	totalDays : number
	cells : HeatmapCell[]
}

// 打卡数据按用户名隔离，未登录时归入 guest
function getCurrentUsername() : string {
	const username = uni.getStorageSync(LOGIN_USER_KEY) as string
	if (username.length > 0) {
		return username
	}

	return 'guest'
}

function getCheckInStorageKey() : string {
	// 按用户隔离打卡记录，避免多人登录同一设备时数据混用
	return CHECK_IN_KEY_PREFIX + getCurrentUsername()
}

function formatDateKey(date : Date) : string {
	// 使用 YYYY-MM-DD 作为本地存储 key，便于按天查找和连续天数计算
	const year = date.getFullYear()
	const month = String(date.getMonth() + 1).padStart(2, '0')
	const day = String(date.getDate()).padStart(2, '0')
	return year + '-' + month + '-' + day
}

function readCheckInRecords() : CheckInRecord[] {
	const storedValue = uni.getStorageSync(getCheckInStorageKey())
	if (storedValue == null || storedValue == '') {
		return []
	}

	return storedValue as CheckInRecord[]
}

function getLevel(count : number) : number {
	// level 预留 0-4 五档颜色；当前 count 会被归一到 0 或 1
	if (count <= 0) {
		return 0
	}
	if (count == 1) {
		return 1
	}
	if (count == 2) {
		return 2
	}
	if (count == 3) {
		return 3
	}
	return 4
}

// 记录今天完成过一次练习或刷题
export function recordTodayCheckIn() {
	const todayKey = formatDateKey(new Date())
	const records = readCheckInRecords()
	const nextRecords = [] as CheckInRecord[]
	let matched = false

	for (const record of records) {
		if (record.date == todayKey) {
			// 当天重复练习仍只记录为打卡完成，不累加次数
			nextRecords.push({
				date: record.date,
				count: 1,
			})
			matched = true
			continue
		}

		nextRecords.push({
			date: record.date,
			// 旧数据只保留是否打过卡，避免异常 count 影响热力图颜色
			count: Number(record.count || 0) > 0 ? 1 : 0,
		})
	}

	if (!matched) {
		// 今天第一次练习时新增当天记录
		nextRecords.push({
			date: todayKey,
			count: 1,
		})
	}

	uni.setStorageSync(getCheckInStorageKey(), nextRecords)
}

// 生成连续打卡天数、累计天数和最近 daySpan 天热力图数据
export function getCheckInSummary(daySpan : number = 84) : CheckInSummary {
	const records = readCheckInRecords()
	const countsByDate = {} as UTSJSONObject

	for (const record of records) {
		// 转成日期索引表，后面生成连续日期窗口时可以 O(1) 查找
		countsByDate[record.date] = Number(record.count || 0)
	}

	const cells = [] as HeatmapCell[]
	const today = new Date()
	let streak = 0
	let countingStreak = true

	for (let offset = daySpan - 1; offset >= 0; offset--) {
		const currentDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() - offset)
		const dateKey = formatDateKey(currentDate)
		const count = Number(countsByDate[dateKey] || 0)
		// 从最早日期到今天生成固定长度单元格，保证热力图网格稳定
		cells.push({
			key: dateKey,
			date: dateKey,
			count,
			level: getLevel(count),
		})
	}

	for (let offset = 0; offset < daySpan; offset++) {
		const currentDate = new Date(today.getFullYear(), today.getMonth(), today.getDate() - offset)
		const dateKey = formatDateKey(currentDate)
		const count = Number(countsByDate[dateKey] || 0)
		if (count > 0 && countingStreak) {
			// 从今天往前连续计数，遇到第一个未打卡日后停止
			streak += 1
			continue
		}
		countingStreak = false
	}

	let totalDays = 0
	for (const record of records) {
		if (Number(record.count || 0) > 0) {
			// 累计打卡天数统计所有历史记录，不限最近 12 周
			totalDays += 1
		}
	}

	return {
		streak,
		totalDays,
		cells,
	}
}
