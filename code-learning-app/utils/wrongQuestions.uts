// 功能：管理练习错题本，负责按用户保存错题、读取错题分组，并把错题数量同步到后端统计接口
import { getApiUrl } from './api.uts'

const WRONG_QUESTIONS_KEY_PREFIX = 'wrongQuestionCollection::'
const LOGIN_USER_KEY = 'loggedInUser'

// 练习页传入的题目结构，保存错题时只依赖题干、选项和标准答案
export type PracticeQuestion = {
	id : string
	prompt : string
	options : string[]
	correctAnswer : string
}

// 错题本实际存储的结构，包含所属学习路径和模块，便于按路径分组展示
export type WrongQuestionItem = {
	pathId : string
	pathTitle : string
	moduleId : string
	moduleTitle : string
	questionId : string
	prompt : string
	selectedAnswer : string
	correctAnswer : string
}

// 错题本页面按学习路径展示，每个分组内保存该路径下的错题列表
export type WrongQuestionGroup = {
	pathId : string
	pathTitle : string
	items : WrongQuestionItem[]
}

// 固定学习路径顺序，确保错题本即使某路径暂无错题也会展示空态
const DEFAULT_PATH_GROUPS = [
	{ pathId: 'javascript', pathTitle: 'JavaScript' },
	{ pathId: 'java', pathTitle: 'Java' },
	{ pathId: 'postgresql-redis', pathTitle: 'PostgreSQL and Redis' },
	{ pathId: 'ai-basics', pathTitle: 'AI Basic Knowledge' },
] as { pathId : string, pathTitle : string }[]

// 从当前用户自己的本地存储中读取错题列表
function readWrongQuestionItems() : WrongQuestionItem[] {
	const storedValue = uni.getStorageSync(getWrongQuestionsStorageKey())
	if (storedValue == null || storedValue == '') {
		return []
	}

	return storedValue as WrongQuestionItem[]
}

function getCurrentUsername() : string {
	const username = uni.getStorageSync(LOGIN_USER_KEY) as string
	if (username.length > 0) {
		return username
	}

	// 未登录情况下仍允许本地记录错题，统一归到 guest 分组
	return 'guest'
}

// 错题本按用户名隔离，避免多个用户共用同一份错题数据
function getWrongQuestionsStorageKey() : string {
	return WRONG_QUESTIONS_KEY_PREFIX + getCurrentUsername()
}

// 把某个模块的错题数量同步到后端 analytics，用于后台学习数据看板
function syncWrongAnswerSnapshot(
	username : string,
	pathId : string,
	pathTitle : string,
	moduleId : string,
	moduleTitle : string,
	wrongCount : number
) {
	// 错题同步只影响后台统计，看板不可用时不阻塞本地错题保存
	uni.request({
		url: getApiUrl('/api/analytics/wrong-answers'),
		method: 'POST',
		header: {
			'Content-Type': 'application/json',
		},
		data: {
			username,
			pathId,
			pathTitle,
			moduleId,
			moduleTitle,
			wrongCount,
		},
	})
}

// 保存一次练习提交中的错题，已存在的同题错题会被最新答案覆盖
export function saveWrongQuestionsForModule(
	pathId : string,
	pathTitle : string,
	moduleId : string,
	moduleTitle : string,
	questions : PracticeQuestion[],
	answers : string[],
	wrongQuestionIds : string[] = [],
	wrongAnswers : string[] = []
) {
	const currentItems = readWrongQuestionItems()
	// 复制一份再修改，避免直接在原数组引用上操作导致状态不可预期
	const nextItems = [...currentItems] as WrongQuestionItem[]

	for (let i = 0; i < questions.length; i++) {
		const question = questions[i]
		const selectedAnswer = answers[i]
		// wrongQuestionIds 记录用户作答过程中曾经选错过的题目
		const wasWrongBefore = wrongQuestionIds.indexOf(question.id) >= 0
		// wrongAnswers 保存首次错误选项，用于错题本展示“你的答案”
		const savedWrongAnswer = i < wrongAnswers.length ? wrongAnswers[i] : ''
		if (selectedAnswer == question.correctAnswer && !wasWrongBefore) {
			// 本次答对且之前没有错过，不进入错题本
			continue
		}

		const nextItem = {
			pathId,
			pathTitle,
			moduleId,
			moduleTitle,
			questionId: question.id,
			prompt: question.prompt,
			selectedAnswer: savedWrongAnswer.length > 0 ? savedWrongAnswer : selectedAnswer,
			correctAnswer: question.correctAnswer,
		} as WrongQuestionItem
		// 同一模块同一道题只保留一条错题记录，重复提交时用最新内容覆盖
		const existingIndex = nextItems.findIndex((item) : boolean => item.moduleId == moduleId && item.questionId == question.id)
		if (existingIndex >= 0) {
			nextItems[existingIndex] = nextItem
		} else {
			nextItems.push(nextItem)
		}
	}

	uni.setStorageSync(getWrongQuestionsStorageKey(), nextItems)
	// 同步的是当前模块剩余错题数量，不是本次新增数量
	const wrongCount = nextItems.filter((item) : boolean => item.moduleId == moduleId).length
	syncWrongAnswerSnapshot(getCurrentUsername(), pathId, pathTitle, moduleId, moduleTitle, wrongCount)
}

// 个人中心和错题本页面按学习路径分组展示错题
export function getWrongQuestionGroups() : WrongQuestionGroup[] {
	const items = readWrongQuestionItems()
	const groups = [] as WrongQuestionGroup[]

	for (const defaultGroup of DEFAULT_PATH_GROUPS) {
		// 按 pathId 过滤，保持页面展示顺序与 DEFAULT_PATH_GROUPS 一致
		groups.push({
			pathId: defaultGroup.pathId,
			pathTitle: defaultGroup.pathTitle,
			items: items.filter((item) : boolean => item.pathId == defaultGroup.pathId),
		})
	}

	return groups
}

// 统计当前用户错题总数，用于个人中心摘要展示
export function getTotalWrongQuestionCount() : number {
	let total = 0
	for (const group of getWrongQuestionGroups()) {
		total += group.items.length
	}
	return total
}
